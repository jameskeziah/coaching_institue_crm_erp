{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institute OS feature registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "baseline",
    "features",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "date",
        "auditNotes",
        "verificationRun"
      ],
      "properties": {
        "commit": {
          "$ref": "#/definitions/sha"
        },
        "date": {
          "$ref": "#/definitions/date"
        },
        "auditNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "verificationRun": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/feature"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/change"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,12}-[0-9]{3}$"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INCOMPLETE",
        "NOT_BUILT",
        "UNVERIFIED"
      ]
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "criterionId": {
      "type": "string",
      "pattern": "^AC-[1-9][0-9]*$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentId",
        "domain",
        "subdomain",
        "module",
        "name",
        "description",
        "requirementSource",
        "status",
        "frontend",
        "backend",
        "database",
        "security",
        "rbac",
        "integration",
        "testing",
        "productionReadiness",
        "dependencies",
        "sourceEvidence",
        "relatedPullRequests",
        "knownLimitations",
        "remainingImplementation",
        "acceptanceCriteria",
        "verification",
        "priority",
        "targetReleasePhase",
        "lastVerifiedCommit",
        "lastVerifiedDate"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subdomain": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "requirementSource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval",
            "reference"
          ],
          "properties": {
            "approval": {
              "enum": [
                "APPROVED",
                "PROPOSED",
                "OBSERVED"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "frontend": {
          "$ref": "#/definitions/status"
        },
        "backend": {
          "$ref": "#/definitions/status"
        },
        "database": {
          "$ref": "#/definitions/status"
        },
        "security": {
          "$ref": "#/definitions/status"
        },
        "rbac": {
          "$ref": "#/definitions/status"
        },
        "integration": {
          "$ref": "#/definitions/status"
        },
        "testing": {
          "$ref": "#/definitions/status"
        },
        "productionReadiness": {
          "$ref": "#/definitions/status"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "sourceEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "detail"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "frontend",
                  "backend",
                  "database",
                  "security",
                  "integration",
                  "test",
                  "ci",
                  "docs",
                  "ops"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "relatedPullRequests": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "remainingImplementation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "result"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/criterionId"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "result": {
                "enum": [
                  "PASSED",
                  "FAILED",
                  "UNVERIFIED"
                ]
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "kind",
              "reference",
              "commit",
              "date"
            ],
            "properties": {
              "criterionId": {
                "$ref": "#/definitions/criterionId"
              },
              "kind": {
                "enum": [
                  "acceptance-test",
                  "staging-verification"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "commit": {
                "$ref": "#/definitions/sha"
              },
              "date": {
                "$ref": "#/definitions/date"
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "targetReleasePhase": {
          "enum": [
            "A",
            "B",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8",
            "UNSCHEDULED"
          ]
        },
        "lastVerifiedCommit": {
          "anyOf": [
            {
              "$ref": "#/definitions/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastVerifiedDate": {
          "anyOf": [
            {
              "$ref": "#/definitions/date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "from",
        "to",
        "date",
        "summary",
        "reference"
      ],
      "properties": {
        "featureId": {
          "$ref": "#/definitions/id"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/definitions/status"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "$ref": "#/definitions/status"
        },
        "date": {
          "$ref": "#/definitions/date"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
