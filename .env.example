# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Auth
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
RESET_PASSWORD_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
INVITE_TOKEN_DAYS=7
ALLOW_REGISTRATION=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Bootstrap protection
TENANT_BOOTSTRAP_SECRET=replace_with_secure_bootstrap_secret

# Mail
MAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Database
# Use a file path for SQLite or a postgresql:// URL for Postgres.
DATABASE_URL=./server/data.sqlite
DATABASE_SSL=false

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
