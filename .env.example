# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=./database.sqlite
# Or for Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/teacher_scorecard

# Auth
JWT_SECRET=change_this_in_local_env
JWT_EXPIRES_IN=7d
TRIAL_DAYS=14
OWNER_RECOVERY_TOKEN_HOURS=24

# Storage
STORAGE_DIR=storage

# WhatsApp / Messaging
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
MAIL_FROM=no-reply@your-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_WORKER_INTERVAL_MS=60000
EMAIL_OUTBOX_WORKER_LIMIT=20
EMAIL_OUTBOX_STALE_LOCK_MS=600000
