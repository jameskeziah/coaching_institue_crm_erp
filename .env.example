# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Auth
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_characters
ALLOW_REGISTRATION=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Database
# Use a file path for SQLite or a postgresql:// URL for Postgres.
DATABASE_URL=./server/data.sqlite
DATABASE_SSL=false

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
