# Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=30
PLATFORM_LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=5
ONBOARDING_RATE_LIMIT_MAX=3
PUBLIC_ENQUIRY_RATE_LIMIT_MAX=20

# Database
DATABASE_URL=./server/data.sqlite
DATABASE_SSL=false
# Production example:
# DATABASE_URL=postgresql://user:password@localhost:5432/protrack_institute_os
# DATABASE_SSL=true

# Authentication and tenant lifecycle
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
RESET_PASSWORD_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
INVITE_TOKEN_DAYS=7
OWNER_RECOVERY_TOKEN_HOURS=24
TRIAL_DAYS=14
ALLOW_REGISTRATION=false
TENANT_BOOTSTRAP_SECRET=replace-with-a-long-random-bootstrap-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# One-shot platform administrator creation (`npm.cmd run seed:super-admin`)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Email
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_WORKER_INTERVAL_MS=60000
EMAIL_OUTBOX_WORKER_LIMIT=20
EMAIL_OUTBOX_STALE_LOCK_MS=600000

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
