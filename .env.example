JWT_SECRET=replace-with-a-long-random-secret
ALLOW_REGISTRATION=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
PORT=4000
# Optional. Leave empty to use local SQLite at server/data.sqlite.
# Set this for Postgres production/staging deployments.
DATABASE_URL=postgresql://username:password@localhost:5432/teacher_scorecard
DATABASE_SSL=false
