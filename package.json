{
  "name": "protrack-institute-os",
  "description": "Institute CRM/ERP for admissions, counselling, teacher performance, reports, and operations.",
  "private": true,
  "workspaces": [
    "server"
  ],
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API \"vite\" \"npm run dev --workspace server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start:server": "npm run start --workspace server",
    "start:server:production": "cross-env NODE_ENV=production node server/index.js",
    "migrate:tenant": "node server/migrations/add-tenant-columns.js",
    "migrate:admissions-columns": "node server/migrations/011-admission-real-columns.js",
    "migrate:admissions-backfill": "node server/migrations/012-backfill-admission-json.js",
    "migrate:lead-activities": "node server/migrations/013-lead-activities.js",
    "migrate:admission-growth": "node server/migrations/014-admission-assignment-duplicates-campaigns.js",
    "migrate:fee-structures": "node server/migrations/015-fee-structure-templates.js",
    "seed:super-admin": "node server/scripts/create-super-admin.js",
    "audit:onboarding-lifecycle": "node scripts/audit-onboarding-lifecycle.mjs",
    "email:outbox:process": "node scripts/process-email-outbox.mjs",
    "test:mail": "node --test server/tests/mail.service.integration.test.js server/tests/email-outbox.lifecycle.test.js",
    "test:authz": "node --test server/tests/student-followups.authorization.test.js",
    "check:legacy": "node scripts/check-legacy-freeze.mjs",
    "check:tenant": "node scripts/check-tenant-enforcement.mjs",
    "backup:sqlite": "node scripts/sqlite-data-safety.mjs backup",
    "restore:verify:sqlite": "node scripts/sqlite-data-safety.mjs verify-restore",
    "backup:postgres": "node scripts/postgres-data-safety.mjs backup",
    "restore:verify:postgres": "node scripts/postgres-data-safety.mjs verify-restore",
    "restore:provision-and-verify:postgres": "node scripts/postgres-data-safety.mjs provision-and-verify",
    "test:data-safety": "node scripts/sqlite-data-safety.mjs self-test && node scripts/postgres-data-safety.mjs self-test",
    "test:smoke": "node scripts/smoke-test.mjs",
    "pretest:ui": "playwright install chromium",
    "test:ui": "playwright test",
    "pilot:readiness": "node scripts/pilot-readiness.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.4",
    "vite": "^5.4.1"
  }
}
